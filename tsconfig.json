{
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "target": "es5",
    "module": "esnext",
    "types": ["element-plus/global", "lwx-test-ui/typings/volar"],
    "lib": ["es2017", "dom" /* 添加了这一项以支持 console */],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["src/**/*"]
}